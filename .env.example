# --- Supabase (optional) ---------------------------------------------------
# Leave these unset to run on the built-in local demo store (.data/lifeos.json).
# Set BOTH the URL and the service-role key to switch the app to Supabase PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- App secrets -----------------------------------------------------------
# Signs session cookies. Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Enables the /admin view. Choose any strong value; leave empty to disable admin.
ADMIN_ACCESS_CODE=
