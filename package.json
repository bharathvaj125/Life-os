{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "description": "Mission LiFE citizen engagement platform for sustainable energy habits, carbon footprint tracking, community challenges, and rooftop solar awareness.",
  "scripts": {
    "predev": "node ./scripts/copy-ocr-assets.mjs",
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "prebuild": "node ./scripts/copy-ocr-assets.mjs",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2",
    "lucide-react": "^0",
    "next": "15.5.28",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
